Table tb_cart_addresses {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  cart_ID int unsigned [not null]
  street_address varchar(255) [not null]
  city varchar(100) [not null]
  state varchar(100) [not null]
  postal_code varchar(20) [not null]
  country varchar(100) [not null]
  creation_date datetime [not null]
  indexes { (cart_ID) [unique, name: 'uk_cart_address'] }
}

Table tb_cart_items {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  cart_ID int unsigned [not null]
  product_ID int unsigned [not null]
  quantity int unsigned [not null]
  unit_price decimal(10,2) [not null]
  added_date datetime [not null]
}

Table tb_cart_status {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  cart_ID int unsigned [not null]
  status enum('Active','Abandoned','Converted','Cancelled') [not null]
  last_change datetime [not null, note: 'ON UPDATE CURRENT_TIMESTAMP']
  indexes { (cart_ID) [unique, name: 'uk_cart_status'] }
}

Table tb_carts {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  user_ID int [not null]
  creation_date datetime [not null]
  last_update datetime [note: 'ON UPDATE CURRENT_TIMESTAMP']
  indexes { (user_ID) [unique, name: 'uk_cart_user'] }
}

Table tb_logs {
  ID int [pk, not null, note: 'AUTO_INCREMENT']
  table_name varchar(100) [not null]
  operation enum('Create','Read','Update','Delete') [not null]
  db_user varchar(80) [not null]
  description text
  operation_date datetime [not null]
  operation_status varchar(20)
}

Table tb_order_cancellations {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  order_ID int unsigned
  buyer_order_ID int unsigned
  requested_by_user_ID int
  cancellation_scope enum('WholeOrder','SellerOrder','Items') [not null]
  reason_code varchar(60)
  reason_detail varchar(1000)
  cancellation_status enum('Requested','Approved','Rejected','Completed') [not null]
  requested_at datetime [not null]
  reviewed_at datetime
  completed_at datetime
  internal_notes varchar(1000)
  creation_date datetime [not null]
  last_update datetime [note: 'ON UPDATE CURRENT_TIMESTAMP']
}

Table tb_orders {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  key varchar(40) [not null]
  user_ID int [not null]
  total_products int [not null]
  total_cost decimal(10,3) [not null]
  status_string enum('Registered','Wishlist','Payed','Canceled','Delivered','Devolved','Attended','Sended') [not null]
  status bit(1)
  creation_date datetime [not null]
  last_update datetime [note: 'ON UPDATE CURRENT_TIMESTAMP']
}

Table tb_payment_methods {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  name varchar(60) [not null]
  description varchar(255)
  status bit(1) [not null]
  creation_date datetime [not null]
  last_update datetime [note: 'ON UPDATE CURRENT_TIMESTAMP']
  indexes { (name) [unique, name: 'uk_payment_method_name'] }
}

Table tb_payment_transaction {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  payment_ID int unsigned [not null]
  refund_ID int unsigned
  transaction_type enum('Authorization','Capture','Charge','Void','Refund','Chargeback','Adjustment') [not null]
  transaction_status enum('Pending','Succeeded','Failed') [not null]
  amount decimal(10,2) [not null]
  currency char(3) [not null]
  provider varchar(60)
  provider_transaction_id varchar(150)
  idempotency_key varchar(100)
  response_code varchar(100)
  response_message varchar(500)
  request_date datetime [not null]
  response_date datetime
  creation_date datetime [not null]
  last_update datetime [note: 'ON UPDATE CURRENT_TIMESTAMP']
  indexes { (provider, provider_transaction_id) [unique, name: 'uk_payment_transaction_provider_ref'] }
  indexes { (provider, idempotency_key) [unique, name: 'uk_payment_transaction_idempotency'] }
}

Table tb_payments {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  order_ID int unsigned [not null]
  amount decimal(12,2) [not null]
  currency char(3) [not null]
  payment_method enum('Card','SPEI','Transfer','Cash') [not null]
  provider varchar(50)
  provider_reference varchar(150)
  payment_status enum('Pending','Authorized','Paid','Failed','Refunded','PartiallyRefunded') [not null]
  creation_date datetime [not null]
  paid_date datetime
  last_update datetime [note: 'ON UPDATE CURRENT_TIMESTAMP']
  indexes { (provider, provider_reference) [unique, name: 'uk_payment_reference'] }
}

Table tb_people {
  person_ID bigint unsigned [pk, not null, note: 'AUTO_INCREMENT']
  user_ID int [not null]
  title varchar(30)
  given_names varchar(150) [not null]
  family_names varchar(150)
  birth_date date
  gender_ID enum('H','M','Prefiero no decirlo')
  phone varchar(25)
  country_code char(2)
  status bit(1) [not null]
  creation_date datetime [not null]
  last_update datetime [not null, note: 'ON UPDATE CURRENT_TIMESTAMP']
}

Table tb_products {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  SKU varchar(50) [not null]
  name varchar(250) [not null]
  description text
  current_price decimal(10,2) [not null]
  current_stock int unsigned [not null]
  status bit(1)
  creation_date datetime [not null]
  last_update datetime [not null, note: 'ON UPDATE CURRENT_TIMESTAMP']
  indexes { (SKU) [unique, name: 'SKU'] }
}

Table tb_refunds {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  payment_ID int unsigned [not null]
  cancellation_ID int unsigned
  return_ID int unsigned
  reason enum('Cancellation','Return','Adjustment','Goodwill') [not null]
  amount decimal(10,2) [not null]
  currency char(3) [not null]
  refund_status enum('Pending','Submitted','Succeeded','Failed','Canceled') [not null]
  provider varchar(60)
  provider_reference varchar(150)
  requested_by_user_ID int
  reason_detail varchar(1000)
  requested_at datetime [not null]
  processed_at datetime
  creation_date datetime [not null]
  last_update datetime [note: 'ON UPDATE CURRENT_TIMESTAMP']
  indexes { (ID, payment_ID) [unique, name: 'uk_refunds_id_payment'] }
  indexes { (provider, provider_reference) [unique, name: 'uk_refunds_provider_reference'] }
}

Table tb_returns {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  buyer_order_ID int unsigned [not null]
  requested_by_user_ID int
  reason_code varchar(60)
  reason_detail varchar(1000)
  return_status enum('Requested','Authorized','Rejected','LabelCreated','InTransit','Received','Inspected','Approved','PartiallyApproved','Refunded','Closed') [not null]
  return_carrier varchar(100)
  return_tracking_number varchar(150)
  requested_at datetime [not null]
  authorized_at datetime
  received_at datetime
  closed_at datetime
  internal_notes varchar(1000)
  creation_date datetime [not null]
  last_update datetime [note: 'ON UPDATE CURRENT_TIMESTAMP']
}

Table tb_seller_orders {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  order_ID int unsigned [not null]
  seller_ID int [not null]
  subtotal decimal(12,2) [not null]
  shipping_cost decimal(12,2) [not null]
  fulfillment_status enum('Pending','Accepted','Preparing','Sent','Delivered','Canceled','Returned') [not null]
  creation_date datetime [not null]
  last_update datetime [note: 'ON UPDATE CURRENT_TIMESTAMP']
  indexes { (order_ID, seller_ID) [unique, name: 'uk_order_seller'] }
}

Table tb_shipments {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  buyer_order_ID int unsigned [not null]
  address_ID bigint unsigned
  recipient_name varchar(150)
  recipient_phone varchar(25)
  address_line_1 varchar(255)
  address_line_2 varchar(255)
  city varchar(120)
  state_region varchar(120)
  postal_code varchar(20)
  country_code char(2)
  carrier varchar(100)
  service_level varchar(100)
  tracking_number varchar(150)
  tracking_url varchar(500)
  shipment_status enum('Pending','LabelCreated','ReadyToShip','InTransit','OutForDelivery','Delivered','DeliveryFailed','Lost','Returned') [not null]
  shipping_cost decimal(12,2) [not null]
  shipped_at datetime
  estimated_delivery_at datetime
  delivered_at datetime
  creation_date datetime [not null]
  last_update datetime [note: 'ON UPDATE CURRENT_TIMESTAMP']
}

Table tb_user_addresses {
  ID bigint unsigned [pk, not null, note: 'AUTO_INCREMENT']
  user_ID int [not null]
  address_label varchar(100) [not null]
  recipient_name varchar(150)
  recipient_phone varchar(25)
  delivery_instructions varchar(500)
  latitude decimal(10,7)
  longitude decimal(10,7)
  is_default tinyint(1) [not null]
  status bit(1) [not null]
  creation_date datetime [not null]
  last_update datetime [note: 'ON UPDATE CURRENT_TIMESTAMP']
}

Table tb_users {
  ID int [pk, not null, note: 'AUTO_INCREMENT']
  email varchar(80) [not null]
  nickname varchar(100) [not null]
  password varchar(255) [not null]
  creation_date datetime [not null]
  last_update datetime [note: 'ON UPDATE CURRENT_TIMESTAMP']
  last_login datetime
  status bit(1) [not null]
  indexes { (email) [unique, name: 'email'] }
  indexes { (nickname) [unique, name: 'nickname'] }
}

Table tbc_categories {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  name varchar(120) [not null]
  description text
  sup_id_category int unsigned
  status bit(1) [not null]
  creation_date datetime [not null]
  last_update datetime [not null, note: 'ON UPDATE CURRENT_TIMESTAMP']
  indexes { (name) [unique, name: 'name'] }
}

Table tbc_gen_email_domains {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  country_code char(2) [not null]
  domain varchar(60) [not null]
  weight int unsigned [not null]
  status bit(1) [not null]
  indexes { (country_code, domain) [unique, name: 'uq_gen_domain'] }
}

Table tbc_gen_family_names {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  country_code char(2) [not null]
  name varchar(60) [not null]
  weight int unsigned [not null]
  status bit(1) [not null]
  indexes { (country_code, name) [unique, name: 'uq_gen_family'] }
}

Table tbc_gen_given_names {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  country_code char(2) [not null]
  gender char(1) [not null]
  name varchar(60) [not null]
  weight int unsigned [not null]
  birth_year_from smallint [not null]
  birth_year_to smallint [not null]
  status bit(1) [not null]
  indexes { (country_code, gender, name) [unique, name: 'uq_gen_given'] }
}

Table tbc_gen_phone_area_codes {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  country_code char(2) [not null]
  area_code char(3) [not null]
  weight int unsigned [not null]
  status bit(1) [not null]
  indexes { (country_code, area_code) [unique, name: 'uq_gen_area'] }
}

Table tbc_payment_methods_types {
  id int [pk, not null, note: 'AUTO_INCREMENT']
  code varchar(50) [not null]
  description varchar(255)
  indexes { (code) [unique, name: 'code_UNIQUE'] }
}

Table tbd_address_components {
  ID bigint unsigned [pk, not null, note: 'AUTO_INCREMENT']
  address_ID bigint unsigned [not null]
  value varchar(255) [not null]
  component_type varchar(50) [not null]
  status bit(1) [not null]
  address_sup_ID bigint unsigned
  creation_date datetime [not null]
  last_update datetime [note: 'ON UPDATE CURRENT_TIMESTAMP']
  indexes { (address_ID, ID) [unique, name: 'uk_address_component'] }
}

Table tbd_buyer_orders {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  seller_ID int [not null]
  subtotal decimal(12,2) [not null]
  shipping_cost decimal(12,2) [not null]
  fulfillment_status enum('Pending','Accepted','Preparing','Sent','Delivered','Canceled','Returned') [not null]
  status bit(1) [not null]
  creation_date datetime [not null]
  last_update datetime [note: 'ON UPDATE CURRENT_TIMESTAMP']
}

Table tbd_cancellation_items {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  cancellation_ID int unsigned [not null]
  order_item_ID int unsigned [not null]
  quantity int unsigned [not null]
  creation_date datetime [not null]
  indexes { (cancellation_ID, order_item_ID) [unique, name: 'uk_cancellation_order_item'] }
}

Table tbd_cart_items {
  cart_ID int unsigned [pk, not null]
  product_offer_ID int unsigned [pk, not null]
  quantity int unsigned [not null]
  creation_date datetime [not null]
}

Table tbd_order_items {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  seller_order_ID int unsigned [not null]
  product_offer_ID int unsigned [not null]
  product_name varchar(255) [not null]
  quantity int unsigned [not null]
  unit_price decimal(12,2) [not null]
  subtotal decimal(12,2) [note: 'GENERATED']
  creation_date datetime [not null]
}

Table tbd_products_categories {
  category_ID int unsigned [pk, not null]
  product_ID int unsigned [pk, not null]
  status bit(1) [not null]
  creation_date datetime [not null]
  last_update datetime [not null, note: 'ON UPDATE CURRENT_TIMESTAMP']
}

Table tbd_products_users_providers {
  user_ID int [pk, not null]
  product_ID int unsigned [pk, not null]
  type_ownership enum('Owner','Reseller','Distributor')
  status bit(1) [not null]
  available_date datetime [not null]
  creation_date datetime [not null]
  last_update datetime [not null, note: 'ON UPDATE CURRENT_TIMESTAMP']
}

Table tbd_return_items {
  ID int unsigned [pk, not null, note: 'AUTO_INCREMENT']
  return_ID int unsigned [not null]
  order_item_ID int unsigned [not null]
  quantity int unsigned [not null]
  item_condition enum('Unopened','Unused','Used','Damaged','Defective','Other')
  disposition enum('Pending','Restock','Repair','Dispose','SupplierReturn') [not null]
  approved_refund_amount decimal(12,2) [not null]
  item_status enum('Requested','Approved','Rejected','Received','Refunded') [not null]
  creation_date datetime [not null]
  last_update datetime [note: 'ON UPDATE CURRENT_TIMESTAMP']
  indexes { (return_ID, order_item_ID) [unique, name: 'uk_return_order_item'] }
}

Table tbd_user_payment_methods {
  id int [pk, not null, note: 'AUTO_INCREMENT']
  user_ID int [not null]
  payment_method_type_ID int [not null]
  provider varchar(100) [not null]
  provider_method_ref varchar(255) [not null]
  created_at timestamp
  indexes { (provider, provider_method_ref) [unique, name: 'uk_provider_method'] }
}

Table tbd_users_wishlist_products {
  user_ID int [pk, not null]
  product_ID int unsigned [pk, not null]
  status bit(1) [not null]
  creation_date datetime [not null]
  last_update datetime [not null, note: 'ON UPDATE CURRENT_TIMESTAMP']
}

Ref: tb_cart_addresses.cart_ID > tb_carts.ID
Ref: tb_cart_items.cart_ID > tb_carts.ID
Ref: tb_cart_items.product_ID > tb_products.ID
Ref: tb_cart_status.cart_ID > tb_carts.ID
Ref: tb_carts.user_ID > tb_users.ID
Ref: tb_order_cancellations.buyer_order_ID > tbd_buyer_orders.ID
Ref: tb_order_cancellations.order_ID > tb_orders.ID
Ref: tb_order_cancellations.requested_by_user_ID > tb_users.ID
Ref: tb_orders.user_ID > tb_users.ID
Ref: tb_payment_transaction.payment_ID > tb_payments.ID
Ref: tb_payment_transaction.refund_ID > tb_refunds.ID
Ref: tb_payment_transaction.payment_ID > tb_refunds.payment_ID
Ref: tb_payments.order_ID > tb_orders.ID
Ref: tb_people.user_ID > tb_users.ID
Ref: tb_refunds.cancellation_ID > tb_order_cancellations.ID
Ref: tb_refunds.payment_ID > tb_payments.ID
Ref: tb_refunds.requested_by_user_ID > tb_users.ID
Ref: tb_refunds.return_ID > tb_returns.ID
Ref: tb_returns.buyer_order_ID > tbd_buyer_orders.ID
Ref: tb_returns.requested_by_user_ID > tb_users.ID
Ref: tb_seller_orders.order_ID > tb_orders.ID
Ref: tb_seller_orders.seller_ID > tb_users.ID
Ref: tb_shipments.address_ID > tb_user_addresses.ID
Ref: tb_shipments.buyer_order_ID > tbd_buyer_orders.ID
Ref: tb_user_addresses.user_ID > tb_users.ID
Ref: tbc_categories.sup_id_category > tbc_categories.ID
Ref: tbd_address_components.address_ID > tb_user_addresses.ID
Ref: tbd_address_components.address_ID > tbd_address_components.address_ID
Ref: tbd_address_components.address_sup_ID > tbd_address_components.ID
Ref: tbd_buyer_orders.seller_ID > tb_users.ID
Ref: tbd_cancellation_items.cancellation_ID > tb_order_cancellations.ID
Ref: tbd_cancellation_items.order_item_ID > tbd_order_items.ID
Ref: tbd_cart_items.cart_ID > tb_carts.ID
Ref: tbd_order_items.seller_order_ID > tb_seller_orders.ID
Ref: tbd_products_categories.category_ID > tbc_categories.ID
Ref: tbd_products_categories.product_ID > tb_products.ID
Ref: tbd_products_users_providers.product_ID > tb_products.ID
Ref: tbd_products_users_providers.user_ID > tb_users.ID
Ref: tbd_return_items.order_item_ID > tbd_order_items.ID
Ref: tbd_return_items.return_ID > tb_returns.ID
Ref: tbd_user_payment_methods.user_ID > tb_users.ID
Ref: tbd_user_payment_methods.payment_method_type_ID > tbc_payment_methods_types.id
Ref: tbd_users_wishlist_products.product_ID > tb_products.ID
Ref: tbd_users_wishlist_products.user_ID > tb_users.ID
